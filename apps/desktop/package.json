{
  "name": "@aipad/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "dist": "electron-builder --config electron-builder.json",
    "dist:linux": "electron-builder --linux --config electron-builder.json",
    "dist:mac": "electron-builder --mac --config electron-builder.json",
    "dist:win": "electron-builder --win --config electron-builder.json",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "electron-updater": "^6.3.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@aipad/contracts": "workspace:*",
    "@aipad/core": "workspace:*",
    "@aipad/keymap": "workspace:*",
    "@aipad/terminal-host": "workspace:*",
    "@types/node": "^20.14.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
